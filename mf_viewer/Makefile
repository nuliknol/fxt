####### Compile

main.o: src/main.cpp include/mainwindow.h \
		include/candle.h \
		include/mf_view.h \
		include/layer.h \
		include/prediction_layer.h \
		include/hmm_client.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o main.o src/main.cpp

mainwindow.o: src/mainwindow.cpp include/mainwindow.h \
		include/candle.h \
		include/mf_view.h \
		include/layer.h \
		include/prediction_layer.h \
		include/hmm_client.h \
		include/logger.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mainwindow.o src/mainwindow.cpp

mf_view.o: src/mf_view.cpp include/mf_view.h \
		include/candle.h \
		include/layer.h \
		include/prediction_layer.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o mf_view.o src/mf_view.cpp

hmm_client.o: src/hmm_client.cpp include/hmm_client.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o hmm_client.o src/hmm_client.cpp

prediction_layer.o: src/prediction_layer.cpp include/prediction_layer.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o prediction_layer.o src/prediction_layer.cpp

logger.o: src/logger.cpp include/logger.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o logger.o src/logger.cpp

moc_mainwindow.o: moc_mainwindow.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mainwindow.o moc_mainwindow.cpp

moc_mf_view.o: moc_mf_view.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_mf_view.o moc_mf_view.cpp

moc_hmm_client.o: moc_hmm_client.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_hmm_client.o moc_hmm_client.cpp

moc_logger.o: moc_logger.cpp 
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o moc_logger.o moc_logger.cpp


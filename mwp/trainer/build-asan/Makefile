	$(MAKE) $(MAKESILENT) -f CMakeFiles/trainer_core.dir/build.make CMakeFiles/trainer_core.dir/src/word_mining.c.i
.PHONY : src/word_mining.c.i

src/word_mining.s: src/word_mining.c.s
.PHONY : src/word_mining.s

